# ==============================================================
# TITANAIR EXECUTIVE NEWSLETTER — Configuration
# ==============================================================
# Copier ce fichier en .env et remplir les valeurs
# ==============================================================

# --- Brevo (ex-Sendinblue) ---
BREVO_API_KEY=your-brevo-api-key-here

# --- Google Cloud TTS ---
# Chemin vers le fichier JSON de credentials Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./gcloud-credentials.json

# --- Destinataires ---
# Liste d'adresses email des dirigeants, séparées par des virgules
RECIPIENTS=dirigeant1@titanair.fr,dirigeant2@titanair.fr

# --- Expéditeur ---
SENDER_EMAIL=newsletter@titanair.fr
SENDER_NAME=Titanair Executive Brief

# --- Paramètres ---
# Heure d'envoi (utilisé par le cron, format HH:MM)
SEND_TIME=07:30
# Fuseau horaire
TIMEZONE=Europe/Paris
